<Window x:Class="Frlg.Trade.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="FRLG 交换中心" Width="1120" Height="810" MinWidth="900" MinHeight="700"
 Background="#087D8C" FontFamily="Microsoft YaHei UI" Foreground="White"
 WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="Visible"/>
  <DataTemplate x:Key="PokemonTile">
   <Border BorderBrush="{Binding Outline}" BorderThickness="2" CornerRadius="6" Margin="7" Padding="10"
    Background="#235BB4" ToolTip="{Binding Details}" AllowDrop="True" Drop="Slot_Drop" DragOver="Slot_DragOver"
    MouseLeftButtonUp="Slot_Click" Tag="{Binding}">
    <Border.ContextMenu><ContextMenu Opened="SlotMenu_Opened">
     <MenuItem Header="导入 PK3…" Click="Import_Click"/>
     <MenuItem Header="导出 PK3…" Click="Export_Click"/>
     <MenuItem Header="查看信息" Click="Details_Click"/>
     <Separator/><MenuItem Header="清空槽位" Click="Clear_Click"/>
    </ContextMenu></Border.ContextMenu>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
      <Image Source="{Binding Sprite}" Stretch="Uniform" MaxHeight="88" Margin="4,2,8,4" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
       <TextBlock Text="{Binding Gender}" Foreground="{Binding GenderBrush}" FontSize="21" HorizontalAlignment="Right"/>
       <TextBlock Text="{Binding Level}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Right"/>
      </StackPanel>
     </Grid>
     <Border Grid.Row="1" Background="#4981CF" CornerRadius="3" Visibility="{Binding Occupied, Converter={StaticResource Visible}}">
      <Viewbox StretchDirection="DownOnly" Margin="4,3"><TextBlock Text="{Binding Nickname}" FontSize="19" FontWeight="SemiBold"/></Viewbox>
     </Border>
    </Grid>
   </Border>
  </DataTemplate>
 </Window.Resources>
 <Grid Margin="24,18,24,20">
  <Grid.RowDefinitions>
   <RowDefinition Height="52"/><RowDefinition Height="48"/><RowDefinition Height="*"/>
   <RowDefinition Height="66"/><RowDefinition Height="54"/>
  </Grid.RowDefinitions>
  <DockPanel>
   <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
    <TextBlock Text="FRLG" FontSize="25" FontWeight="Bold"/>
    <TextBlock Text="交换中心" FontSize="18" Margin="13,5,0,0" Foreground="#CDF5EE"/>
   </StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <TextBlock x:Name="DeviceLabel" Text="串口设备" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="13"/>
    <ComboBox x:Name="PortBox" Width="102" SelectionChanged="Port_Changed"/>
    <Button x:Name="RefreshPorts" Margin="6,0,0,0" Padding="9,7" Background="#C5EAE6" Click="Refresh_Click" ToolTip="刷新串口">
     <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE72C;" FontSize="16"/>
    </Button>
   </StackPanel>
  </DockPanel>
  <DockPanel Grid.Row="1" LastChildFill="True">
   <CheckBox x:Name="AutoOt" Content="自动同步对方初训家" VerticalAlignment="Center" Foreground="White" FontSize="14"
    Checked="AutoOt_Changed" Unchecked="AutoOt_Changed" Margin="0,0,12,0"/>
   <Button x:Name="SyncOt" Padding="9,7" VerticalAlignment="Center" Background="#C5EAE6" IsEnabled="False" Click="SyncOt_Click" ToolTip="立即同步初训家">
    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8AB;" FontSize="16"/>
   </Button>
   <TextBlock x:Name="OtStatus" Text="" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="12" Foreground="#C9F6EE" Margin="10,0,0,0"/>
  </DockPanel>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Grid Background="#174C9D">
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#F7C842" Margin="8,0,8,0" CornerRadius="4">
     <TextBlock x:Name="OpponentName" Text="对方" Foreground="#243A50" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ItemsControl x:Name="OpponentGrid" Grid.Row="1" ItemsSource="{Binding OpponentSlots}" ItemTemplate="{StaticResource PokemonTile}" Margin="1,8,1,1">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="3" Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
   </Grid>
   <Grid Grid.Column="2" Background="#174C9D">
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Background="#F7C842" Margin="8,0,8,0" CornerRadius="4">
     <TextBlock Text="EMU" Foreground="#243A50" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ItemsControl x:Name="LocalGrid" Grid.Row="1" ItemsSource="{Binding LocalParty.Slots}" ItemTemplate="{StaticResource PokemonTile}" Margin="1,8,1,1">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="3" Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    </ItemsControl>
   </Grid>
  </Grid>
  <Grid Grid.Row="3" Margin="2,11,2,5">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock x:Name="StatusText" Text="未连接" FontSize="15" TextTrimming="CharacterEllipsis"
     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <TextBlock x:Name="PendingText" Text="" Foreground="#FFE694" FontSize="12" Margin="0,4,0,0"/>
   </StackPanel>
   <Button Grid.Column="1" Padding="10,7" Background="Transparent" Foreground="#D0F2F2" Click="OpenLogs_Click" ToolTip="打开本次日志">
    <TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8A5;" FontSize="19"/>
   </Button>
  </Grid>
  <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">
   <Button x:Name="ConnectButton" Width="148" Margin="0,5,12,0" Click="Connect_Click">
    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE839;" Margin="0,2,9,0"/><TextBlock Text="连接"/></StackPanel>
   </Button>
   <Button x:Name="DisconnectButton" Width="148" Margin="0,5,0,0" Background="#D4EBE7" IsEnabled="False" Click="Disconnect_Click">
    <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8CD;" Margin="0,2,9,0"/><TextBlock x:Name="DisconnectLabel" Text="断开"/></StackPanel>
   </Button>
  </StackPanel>
 </Grid>
</Window>
