<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Frlg.Trade.Desktop</AssemblyName>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../assets/party/*.pk3" LogicalName="Assets.party.%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../assets/sprites/*.png" LogicalName="Assets.sprites.%(Filename)%(Extension)" />
    <ProjectReference Include="../core/Frlg.Trade.Core.csproj" />
    <PackageReference Include="PKHeX.Core" Version="26.8.26" />
    <PackageReference Include="System.IO.Ports" Version="10.0.7" />
  </ItemGroup>
</Project>
